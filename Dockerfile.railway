# Multi-stage build for Railway
FROM eclipse-temurin:17-jdk-jammy as builder

WORKDIR /dspace

# Install build dependencies
RUN apt-get update && apt-get install -y \
    maven \
    git \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Copy only what's needed for Maven build
COPY pom.xml .
COPY dspace/ ./dspace/

# Build DSpace
RUN mvn -U clean package -DskipTests -Dmaven.test.skip=true -Djava.awt.headless=true

# Runtime stage
FROM eclipse-temurin:17-jre-jammy

WORKDIR /dspace

# Copy only the built JAR
COPY --from=builder /dspace/dspace-server-webapp/target/dspace-server-webapp.jar .

EXPOSE 8080

CMD ["java","-jar","dspace-server-webapp.jar"]
