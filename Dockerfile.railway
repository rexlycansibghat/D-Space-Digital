FROM eclipse-temurin:17-jdk-jammy AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y \
    maven \
    git \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

COPY . /build

WORKDIR /build/dspace

RUN mvn -U clean package -DskipTests

FROM eclipse-temurin:17-jre-jammy

WORKDIR /dspace

COPY --from=builder /build/dspace/target/dspace-installer /dspace

RUN /dspace/bin/dspace install

EXPOSE 8080

CMD ["/dspace/bin/dspace","run"]
