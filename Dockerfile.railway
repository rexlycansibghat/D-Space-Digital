FROM eclipse-temurin:17-jdk-jammy

WORKDIR /dspace

RUN apt-get update && apt-get install -y \
    maven \
    git \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

COPY . /dspace

RUN mvn -U clean package -DskipTests

EXPOSE 8080

CMD ["java","-jar","dspace-server-webapp/target/dspace-server-webapp.jar"]
